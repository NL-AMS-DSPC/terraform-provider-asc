            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "GroupResponse": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupMemberResponse"
            }
          },
          "name": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "urn": {
            "type": "string"
          }
        }
