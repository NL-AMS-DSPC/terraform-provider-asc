            }
          }
        },
        "description": "Group creation request",
        "required": true
      }
    },
    "schemas": {
      "CreateRoleRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "UpdateRoleRequest": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "group_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
